<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Menu</title>

  <!-- Fonte Dongle -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Dongle:wght@400;700&display=swap" rel="stylesheet">

  <!-- CSS externo -->
  <link rel="stylesheet" href="css/menu.css">
</head>
<body>

  <div class="tela-menu">

    <!-- Cabeçalho com logo e ícones (src vazio para você preencher depois) -->
    <header>
      <a href="/home-f" class="link-logo">
        <img src="img/logo-codework.png" alt="Logo CW" class="logo-img">
      </a>

      <div class="icones-topo">
        <a href="" class="btn-icone" aria-label="Pesquisar">
          <img src="icones/Search.svg" alt="Pesquisar" class="icone-nav">
        </a>

        <a href="" class="btn-icone" aria-label="Notificações">
          <img src="icones/garden_notification-fill-16.svg" alt="Notificações" class="icone-nav">
        </a>

        <a href="/perfil-f" class="btn-perfil" aria-label="Perfil">
          <img src="" alt="Foto de perfil" class="icone-perfil">
        </a>
      </div>
    </header>

    <!-- Lista de opções do menu -->
    <main>
      <nav aria-label="Menu principal">
        <ul class="lista-menu">
          <li>
            <a href="/home-c">Contrate</a>
          </li>
          <li>
            <a href="home-f">Meus projetos</a>
          </li>
          <!-- <li>
            <a href="">Minhas finanças</a>
          </li> -->
          <li>
            <a href="/home-f">Encontre trabalho</a>
          </li>
          <!-- <li>
            <a href="">Idioma</a>
          </li> -->
          <li>
            <a href="/" class="link-sair">Sair</a>
          </li>
        </ul>
      </nav>
    </main>

  </div>

</body>
</html>